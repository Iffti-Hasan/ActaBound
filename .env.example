# Application Environment Configuration
APP_NAME=ActaBound
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# Execution Modes: 'DEMO' or 'TESTNET'
DEMO_MODE=true

# Database Connection (Docker Compose PostgreSQL)
DATABASE_URL="postgresql://acta:actabound_secret@localhost:5432/actabound_db?schema=public"

# Cryptographic Keys (AES-256-GCM 32-byte Base64 key)
DATA_ENCRYPTION_KEY_BASE64="ebqjd/FScSEeWr0YXuo5ReP5JlmbDHwyZD8S4UNDygM="
AUTH_SECRET="f0a8d6b9e248671c6670868f7d9539bf83e20e8549bd8f615e47854cf605d3e2"

# AI Provider Configuration (Optional - Demo mode works autonomously without keys)
AI_PROVIDER="local_rule_engine"
AI_API_KEY=""
AI_MODEL="gpt-4o"

# EVM Testnet Configuration (Default: Sepolia)
EVM_CHAIN_ID=11155111
EVM_RPC_URL="https://rpc.sepolia.org"
EXPLORER_BASE_URL="https://sepolia.etherscan.io"
